{
  "name": "agent-flows",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "validate": "bun run lint && bun run --filter @agent-flows/core validate && bun run --filter @agent-flows/dev validate",
    "smoke": "bun run --filter '*' smoke"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.10",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
